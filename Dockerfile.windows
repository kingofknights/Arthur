# Use Windows Server Core LTSC 2022
FROM mcr.microsoft.com/windows/servercore:ltsc2022

# Reset shell to PowerShell
SHELL ["powershell", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

# Install Chocolatey
RUN Set-ExecutionPolicy Bypass -Scope Process -Force; \
    [System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072; \
    iex ((New-Object System.Net.WebClient).DownloadString('https://community.chocolatey.org/install.ps1'))

# Install Git, CMake, Ninja, Zip utilities, OpenSSL, and MinGW via Chocolatey
RUN choco install -y git cmake ninja zip openssl mingw

# Add C:\local\bin, MinGW, and OpenSSL to PATH, set CMAKE_PREFIX_PATH and OPENSSL_ROOT_DIR
RUN $path = [Environment]::GetEnvironmentVariable('Path', 'Machine'); \
    [Environment]::SetEnvironmentVariable('Path', $path + ';C:\local\bin;C:\tools\mingw64\bin;C:\Program Files\OpenSSL-Win64\bin', 'Machine')
ENV CMAKE_PREFIX_PATH="C:\\local"
ENV OPENSSL_ROOT_DIR="C:\\Program Files\\OpenSSL-Win64"
ENV CC="gcc"
ENV CXX="g++"

# Clone and bootstrap vcpkg
RUN git clone --depth 1 https://github.com/microsoft/vcpkg.git C:\vcpkg; \
    C:\vcpkg\bootstrap-vcpkg.bat -disableMetrics

# Add vcpkg to PATH
RUN $path = [Environment]::GetEnvironmentVariable('Path', 'Machine'); \
    [Environment]::SetEnvironmentVariable('Path', $path + ';C:\vcpkg', 'Machine')

# Install dependencies via vcpkg (using x64-mingw-static triplet)
RUN vcpkg install --triplet=x64-mingw-static --host-triplet=x64-mingw-static \
    fmt nlohmann-json libpqxx sdl3 sqlitecpp openssl

# Copy build-dependencies.ps1 script into the container image
COPY build-dependencies.ps1 C:/build-dependencies.ps1

# Run build-dependencies.ps1 inside the container to build and install Boost 1.74.0 to C:\local
RUN powershell -File C:/build-dependencies.ps1; \
    Remove-Item C:/build-dependencies.ps1 -Force

# Copy build-project.ps1 into the container image
COPY build-project.ps1 C:/build-project.ps1

# Default entrypoint to build the project
ENTRYPOINT ["powershell", "-File", "C:\\build-project.ps1"]
